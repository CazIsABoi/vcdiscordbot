# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token-here

# Optional: restrict slash command sync to one guild for instant updates during development.
# Leave blank to sync globally (takes up to an hour to propagate).
DEV_GUILD_ID=

# Path to the SQLite database file used for guild configuration and temp channel tracking.
DATABASE_PATH=data/tempvc.db

# GitHub OAuth App used by /github link (Settings > Developer settings > OAuth Apps,
# with "Enable Device Flow" ticked). Leave blank to disable the GitHub feature.
GITHUB_CLIENT_ID=
# Optional: lets the bot revoke each GitHub token right after using it.
GITHUB_CLIENT_SECRET=
